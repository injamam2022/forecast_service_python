# Copy to .env and fill in values (do not commit .env)
# cp .env.example .env

# REQUIRED. Same value as the Node API's PY_FORECAST_API_KEY.
# The service refuses to start without it (set FORECAST_DEV_MODE=1 only for local dev).
FORECAST_API_KEY=
# FORECAST_DEV_MODE=1

# Bind address / port. 127.0.0.1 when the Node API runs on the same server.
# Use 0.0.0.0 only behind a firewall that allows the API host alone.
FORECAST_HOST=127.0.0.1
FORECAST_PORT=8001
# Parallel worker processes (each handles one forecast request at a time)
FORECAST_WORKERS=2

# Largest accepted request body in MB
FORECAST_MAX_BODY_MB=200
# DEBUG logs one line per series
FORECAST_LOG_LEVEL=INFO
